# SMART AI Attendance System — Production Environment Template

# Environment & Server Settings
ENV=production
PORT=8000
TRUST_PROXY_HEADERS=true

# Security Keys (Generate a 32+ character random string for production)
# Example command: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection (Supports PostgreSQL, MySQL, Supabase, Neon, AWS RDS, Render)
# PostgreSQL: postgresql://user:password@hostname:5423/dbname
# MySQL: mysql+mysqlconnector://user:password@hostname:3306/dbname
DATABASE_URL=postgresql://user:password@hostname:5432/dbname
ALLOW_DATABASE_FALLBACK=true

# Production CORS Origins (Comma-separated list of allowed frontend domains)
CORS_ORIGINS=https://smart-attendance-system-olive-ten.vercel.app,https://your-custom-domain.com

# Production Controls (Must be false in production)
SEED_DEFAULT_USERS=false
ALLOW_ROLL_PASSWORD=false

# System Owner Identity
SYSTEM_OWNER_EMAIL=rajkishorock@gmail.com

# Optional SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME="SMART AI SYSTEM"
