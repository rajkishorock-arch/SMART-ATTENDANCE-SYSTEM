# Database Connection URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/face_recognition_db"
ENV="development"
ALLOW_DATABASE_FALLBACK="true"

# JWT Authentication Configuration
JWT_SECRET_KEY="your-super-secret-key-that-is-long-and-random-32plus-chars"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
ALGORITHM="HS256"

SYSTEM_OWNER_EMAIL="system.owner@institution.org"
BUILD_CALLBACK_TOKEN="replace-with-a-long-random-build-callback-token"

# Production environment checklist:
# ENV="production"
# ALLOW_DATABASE_FALLBACK="false"
# DATABASE_URL="<your-production-database-url>"
# JWT_SECRET_KEY="<32+ character random secret>"
# BUILD_CALLBACK_TOKEN="<16+ character random callback token>"
# SEED_DEFAULT_USERS="false"

